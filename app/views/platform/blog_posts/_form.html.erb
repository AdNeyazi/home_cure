<%= form_with model: [:platform, blog_post], local: true do |f| %>
  <% if blog_post.errors.any? %>
    <div class="patient-form-errors">
      <strong><%= pluralize(blog_post.errors.count, "error") %> prevented saving:</strong>
      <ul>
        <% blog_post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="patient-form-grid">
    <div class="patient-field patient-field--full">
      <%= f.label :title %>
      <%= f.text_field :title %>
    </div>

    <div class="patient-field">
      <%= f.label :category %>
      <%= f.text_field :category, placeholder: "Diabetes, Thyroid, etc." %>
    </div>

    <div class="patient-field">
      <%= f.label :author_name %>
      <%= f.text_field :author_name %>
    </div>

    <div class="patient-field">
      <%= f.label :reviewer_name %>
      <%= f.text_field :reviewer_name, placeholder: "Reviewed by (doctor/lab specialist)" %>
    </div>

    <div class="patient-field">
      <%= f.label :reviewed_at %>
      <%= f.datetime_local_field :reviewed_at %>
    </div>

    <div class="patient-field patient-field--full">
      <%= f.label :cover_image_url %>
      <%= f.url_field :cover_image_url, placeholder: "https://..." %>
    </div>

    <div class="patient-field patient-field--full">
      <%= f.label :excerpt %>
      <%= f.text_area :excerpt, rows: 3 %>
    </div>

    <div class="patient-field patient-field--full">
      <%= f.label :content %>
      <%= f.text_area :content, rows: 10 %>
    </div>

    <div class="patient-field patient-field--full">
      <%= f.label :preparation_tips, "Preparation Tips (one tip per line)" %>
      <%= f.text_area :preparation_tips, rows: 6, placeholder: "Drink water before sample collection" %>
    </div>

    <div class="patient-field patient-field--full">
      <%= f.label :faq_items, "FAQ Items (Question || Answer per line)" %>
      <%= f.text_area :faq_items, rows: 6, placeholder: "Do I need fasting? || Yes, 8 to 12 hours for this test." %>
    </div>

    <div class="patient-field patient-field--full">
      <%= f.label :medical_disclaimer %>
      <%= f.text_area :medical_disclaimer, rows: 3 %>
    </div>

    <div class="patient-field">
      <%= f.label :published_at %>
      <%= f.datetime_local_field :published_at %>
    </div>

    <div class="patient-field">
      <%= f.label :slug %>
      <%= f.text_field :slug, placeholder: "optional-auto-generated" %>
    </div>

    <div class="patient-field">
      <%= f.label :published %>
      <%= f.check_box :published %>
    </div>

    <div class="patient-field">
      <%= f.label :featured %>
      <%= f.check_box :featured %>
    </div>
  </div>

  <div class="patient-form-actions">
    <%= f.submit class: "admin-btn admin-btn--primary" %>
    <%= link_to "Cancel", platform_blog_posts_path, class: "admin-btn admin-btn--light" %>
  </div>
<% end %>
