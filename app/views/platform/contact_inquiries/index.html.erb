
<div class="container admin-page-wrap">
  <div class="admin-table-wrap">
    <table class="admin-data-table admin-data-table--contacts">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Subject</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @contact_inquiries.each do |inquiry| %>
          <tr>
            <td><%= inquiry.full_name %></td>
            <td><%= inquiry.email %></td>
            <td><%= inquiry.phone_number.presence || "-" %></td>
            <td><%= inquiry.subject %></td>
            <td><%= inquiry.created_at.strftime("%d/%m/%Y %I:%M %p") %></td>
            <td>
              <div class="admin-table-actions">
                <%= link_to "View", platform_contact_inquiry_path(inquiry), class: "admin-link-clear" %>
                <%= link_to "Delete", platform_contact_inquiry_path(inquiry), class: "admin-link-clear", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
