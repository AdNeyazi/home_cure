<section class="contact-page">
  <div class="container">
    <header class="contact-header">
      <p class="contact-header__eyebrow">Contact</p>
      <h1>Talk to us about your lab</h1>
      <p>Questions about onboarding, demos, or moving your lab onto HomeCure? Send a note and we’ll follow up.</p>
    </header>

    <div class="contact-layout">
      <article class="contact-panel">
        <% if @contact_inquiry.errors.any? %>
          <div class="patient-form-errors">
            <strong><%= pluralize(@contact_inquiry.errors.count, "error") %> prevented submission:</strong>
            <ul>
              <% @contact_inquiry.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @contact_inquiry, url: contact_inquiries_path, local: true, class: "contact-form" do |f| %>
          <div class="contact-form__grid">
            <div class="patient-field">
              <%= f.label :full_name %>
              <%= f.text_field :full_name, placeholder: "Your full name" %>
            </div>
            <div class="patient-field">
              <%= f.label :email %>
              <%= f.email_field :email, placeholder: "you@yourlab.com" %>
            </div>
            <div class="patient-field">
              <%= f.label :phone_number %>
              <%= f.telephone_field :phone_number, placeholder: "Phone number" %>
            </div>
            <div class="patient-field">
              <%= f.label :subject %>
              <%= f.text_field :subject, placeholder: "Demo, onboarding, partnership..." %>
            </div>
            <div class="patient-field patient-field--full">
              <%= f.label :message %>
              <%= f.text_area :message, rows: 6, placeholder: "Tell us about your lab and what you need..." %>
            </div>
          </div>
          <%= f.submit "Send message", class: "admin-btn admin-btn--primary" %>
        <% end %>
      </article>

      <aside class="contact-panel">
        <h2>Prefer to start now?</h2>
        <ul class="contact-list">
          <li><%= link_to "Register your lab →", new_lab_registration_path %></li>
          <li><%= link_to "Sign in to your workspace →", new_user_session_path %></li>
          <li><strong>Email:</strong> support@homecurelab.com</li>
        </ul>
      </aside>
    </div>
  </div>
</section>
