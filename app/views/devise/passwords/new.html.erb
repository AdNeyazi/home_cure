<% content_for :title, "Reset password · HomeCure Lab" %>

<header class="auth-form-header">
  <p class="auth-overline">Account recovery</p>
  <h2>Forgot password?</h2>
  <p class="auth-form-header__sub">Enter your email and we’ll send reset instructions.</p>
</header>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "auth-form" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :email %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@lab.com" %>
  </div>

  <div class="actions">
    <%= f.submit "Send reset link →", class: "auth-btn" %>
  </div>
<% end %>

<div class="auth-links">
  <%= render "devise/shared/links" %>
</div>
