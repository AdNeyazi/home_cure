<% content_for :title, "Change password · HomeCure Lab" %>

<header class="auth-form-header">
  <p class="auth-overline">Account recovery</p>
  <h2>Set a new password</h2>
  <p class="auth-form-header__sub">Choose a strong password for your lab workspace.</p>
</header>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="field">
    <%= f.label :password, "New password" %>
    <% if @minimum_password_length %>
      <small class="auth-hint"><%= @minimum_password_length %> characters minimum</small>
    <% end %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password" %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation, "Confirm new password" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <div class="actions">
    <%= f.submit "Update password →", class: "auth-btn" %>
  </div>
<% end %>

<div class="auth-links">
  <%= render "devise/shared/links" %>
</div>
