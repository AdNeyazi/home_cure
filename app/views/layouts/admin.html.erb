<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Admin · HomeCure Lab" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "app", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin-body">
    <%= render "admin/shared/sidebar" %>
    <div class="admin-shell">
      <%= render "admin/shared/breadcrumbs" %>
      <main class="admin-main lf-fade-up">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
