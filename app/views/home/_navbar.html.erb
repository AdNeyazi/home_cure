<nav class="navbar">
  <div class="container navbar__inner">
    <%= link_to root_path, class: "brand" do %>
      Home<span>Cure</span>
    <% end %>

    <ul class="nav-links">
      <li><%= link_to "Product", root_path(anchor: "product") %></li>
      <li><%= link_to "How it works", root_path(anchor: "how-it-works") %></li>
      <li><%= link_to "Blog", blog_posts_path %></li>
      <li><%= link_to "Contact", new_contact_inquiry_path %></li>
    </ul>

    <div class="nav-auth">
      <% if user_signed_in? %>
        <% if current_user.super_admin? %>
          <%= link_to "Platform", platform_root_path, class: "nav-auth__btn nav-auth__btn--admin" %>
        <% elsif current_user.lab_member? %>
          <%= link_to "Dashboard", admin_dashboard_path, class: "nav-auth__btn nav-auth__btn--admin" %>
        <% end %>
        <%= link_to "Account", edit_user_registration_path, class: "nav-auth__btn nav-auth__btn--account" %>
        <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-auth__btn nav-auth__btn--account" %>
      <% else %>
        <%= link_to "Sign in", new_user_session_path, class: "nav-auth__btn nav-auth__btn--account" %>
        <%= link_to "Register lab", new_lab_registration_path, class: "nav-auth__btn nav-auth__btn--admin" %>
      <% end %>
    </div>
  </div>
</nav>
