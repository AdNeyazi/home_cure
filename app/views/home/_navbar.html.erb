<nav class="navbar">
  <div class="container navbar__inner">
    <div class="brand">Home<span>Cure</span></div>

    <ul class="nav-links">
      <li><a href="/">Home</a></li>
      <li><%= link_to "Blog", blog_posts_path %></li>
      <li><%= link_to "Contact", new_contact_inquiry_path %></li>
    </ul>

    <div class="nav-auth">
      <% if user_signed_in? %>
        <% if current_user.admin? %>
          <%= link_to "Admin", admin_dashboard_path, class: "nav-auth__btn nav-auth__btn--admin" %>
        <% end %>
        <%= link_to "Account", edit_user_registration_path, class: "nav-auth__btn nav-auth__btn--account" %>
        <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-auth__btn nav-auth__btn--account" %>
      <% else %>
        <%= link_to "Login", new_user_session_path, class: "nav-auth__btn nav-auth__btn--account" %>
        <%= link_to "Sign Up", new_user_registration_path, class: "nav-auth__btn nav-auth__btn--admin" %>
      <% end %>
    </div>
  </div>
</nav>
