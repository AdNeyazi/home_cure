<section class="appointment">
  <div class="container appointment__inner">
    <div class="appointment__image"></div>
    <div class="appointment__form">
      <h2>Make An Appointment</h2>
      <p>Schedule your appointment with a specialist</p>

      <form>
        <div class="form-grid">
          <input type="text" placeholder="Appointment Date">
          <select><option>Cardiology</option></select>
          <input type="text" placeholder="Patient Name">
          <select><option>Male</option></select>
          <input type="text" placeholder="Phone Number">
          <input type="email" placeholder="Email Address">
          <textarea placeholder="Message"></textarea>
        </div>
        <button type="button" class="btn-main">Make Appointment</button>
      </form>
    </div>
  </div>
</section>
