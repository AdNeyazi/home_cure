<% content_for :title, "Payments · HomeCure Lab" %>

<section class="dir-page lf-fade-up">
  <header class="dir-header">
    <div>
      <p class="dir-header__eyebrow">Billing</p>
      <h1 class="dir-header__title">Payments & Collections</h1>
      <p class="dir-header__meta"><%= pluralize(@bills.size, "payment") %></p>
    </div>
    <div class="dir-header__actions">
      <%= link_to "+ Generate Bill", new_admin_bill_path, class: "dir-btn-primary" %>
    </div>
  </header>

  <div class="dir-stats lf-stagger">
    <article class="dir-stat">
      <p class="dir-stat__label">Today's Collection</p>
      <p class="dir-stat__value"><%= number_to_currency(@today_collection, unit: "₹", precision: 0) %></p>
    </article>
    <article class="dir-stat">
      <p class="dir-stat__label">This Month</p>
      <p class="dir-stat__value"><%= number_to_currency(@month_collection, unit: "₹", precision: 0) %></p>
    </article>
    <article class="dir-stat dir-stat--accent">
      <p class="dir-stat__label">Lifetime</p>
      <p class="dir-stat__value"><%= number_to_currency(@lifetime_collection, unit: "₹", precision: 0) %></p>
    </article>
  </div>

  <div class="dir-panel">
    <div class="dir-table-wrap">
      <table class="dir-table">
        <thead>
          <tr>
            <th>Receipt</th>
            <th>Date</th>
            <th>Order</th>
            <th>Amount</th>
            <th>Mode</th>
            <th>Collected by</th>
          </tr>
        </thead>
        <tbody>
          <% if @bills.any? %>
            <% @bills.each do |bill| %>
              <tr>
                <td>
                  <%= link_to bill.bill_number.presence || "BILL-#{bill.id}",
                              admin_bill_path(bill),
                              class: "dir-table__code" %>
                </td>
                <td class="dir-table__muted"><%= bill.bill_date.strftime("%d %b %Y") %></td>
                <td class="dir-table__muted"><%= patient_display_id(bill.patient) %></td>
                <td class="dir-table__amount"><%= number_to_currency(bill.amount_paid, unit: "₹", precision: 0) %></td>
                <td>
                  <span class="dir-table__mode"><%= bill.status %></span>
                </td>
                <td>
                  <div class="dir-table__actions">
                    <%= link_to "View", admin_bill_path(bill), class: "dir-table__action" %>
                    <%= link_to "Edit", edit_admin_bill_path(bill), class: "dir-table__action dir-table__action--muted" %>
                    <%= link_to "PDF", pdf_admin_bill_path(bill), class: "dir-table__action dir-table__action--muted" %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="dir-empty">No payments yet.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>
