
<div class="container admin-page-wrap">
  <div class="admin-actions-row">
    <%= link_to "New Post", new_admin_blog_post_path, class: "admin-btn admin-btn--primary" %>
  </div>

  <div class="admin-table-wrap">
    <table class="admin-data-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Category</th>
          <th>Published On</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @blog_posts.each do |post| %>
          <tr>
            <td><%= post.title %></td>
            <td><%= post.category %></td>
            <td><%= post.published_at.strftime("%d/%m/%Y") %></td>
            <td><%= post.published? ? "Published" : "Draft" %></td>
            <td>
              <div class="admin-table-actions">
                <%= link_to "Edit", edit_admin_blog_post_path(post), class: "admin-link-clear" %>
                <%= link_to "Delete", admin_blog_post_path(post), class: "admin-link-clear", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
