<div class="container admin-page-wrap">
  <section class="admin-form-card">
    <h2 class="admin-form-card__title"><%= doctor.persisted? ? "Edit Doctor" : "Add Doctor" %></h2>
    <p class="admin-form-card__subtitle">Manage doctor profile and referral contact details.</p>

    <%= form_with model: [:admin, doctor], class: "admin-form" do |f| %>
      <div class="admin-form-grid">
        <p class="admin-form-field">
          <%= f.label :full_name %>
          <%= f.text_field :full_name, class: "admin-form-input" %>
        </p>
        <p class="admin-form-field">
          <%= f.label :specialization %>
          <%= f.text_field :specialization, class: "admin-form-input" %>
        </p>
        <p class="admin-form-field">
          <%= f.label :phone_number %>
          <%= f.text_field :phone_number, class: "admin-form-input" %>
        </p>
        <p class="admin-form-field">
          <%= f.label :email %>
          <%= f.email_field :email, class: "admin-form-input" %>
        </p>
      </div>

      <div class="admin-form-actions">
        <%= f.submit doctor.persisted? ? "Update Doctor" : "Create Doctor", class: "admin-btn admin-btn--primary" %>
      </div>
    <% end %>
  </section>
</div>
